{
  "name": "syntax-analyzer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.22.0",
  "engines": {
    "node": ">=26"
  },
  "author": "Romantech",
  "license": "MIT",
  "description": "Visual tool for English syntax analysis",
  "keywords": [
    "syntax",
    "analysis",
    "English",
    "OpenAI",
    "ChatGPT"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:romantech/syntax-analyzer.git"
  },
  "bugs": {
    "url": "https://github.com/romantech/syntax-analyzer/issues"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json}": "biome check --write"
  },
  "scripts": {
    "dev": "pnpm --filter syntax-analyzer-web dev",
    "dev:mock": "pnpm --filter syntax-analyzer-web dev:mock",
    "dev:api": "pnpm --filter syntax-analyzer-api start:dev",
    "build": "pnpm -r build",
    "lint": "biome check . && pnpm -r lint",
    "test": "pnpm -r test",
    "lint:fix": "biome check --write . && pnpm -r lint:fix",
    "preview": "pnpm --filter syntax-analyzer-web preview",
    "prepare": "husky",
    "i18n:extract": "pnpm --filter syntax-analyzer-web i18n:extract",
    "i18n:types": "pnpm --filter syntax-analyzer-web i18n:types",
    "i18n:check": "pnpm --filter syntax-analyzer-web i18n:check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  }
}
