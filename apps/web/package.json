{
  "name": "syntax-analyzer-web",
  "private": true,
  "version": "1.4.2",
  "type": "module",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json}": "pnpm --filter syntax-analyzer-web exec biome check --write"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc && vite build",
    "lint": "biome check .",
    "test": "node --test tests/*.test.ts",
    "lint:fix": "biome check --write .",
    "preview": "vite preview",
    "i18n:extract": "i18next-cli extract",
    "i18n:types": "i18next-cli types",
    "i18n:check": "i18next-cli extract --ci --dry-run && i18next-cli status && i18next-cli types --ci"
  },
  "dependencies": {
    "@chakra-ui/react": "3.38.0",
    "@emotion/react": "^11.14.0",
    "@formkit/auto-animate": "^0.8.4",
    "@hookform/resolvers": "^7.0.7",
    "@lottiefiles/dotlottie-react": "^0.18.10",
    "@tanstack/react-query": "^5.107.1",
    "@tsparticles/engine": "4.6.0",
    "@tsparticles/preset-links": "4.6.0",
    "@tsparticles/react": "4.6.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "axios": "^1.21.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^11.18.2",
    "i18next": "^27.2.2",
    "jotai": "^3.0.2",
    "nanoid": "^5.1.16",
    "next-themes": "0.4.6",
    "qs": "^6.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.3",
    "react-icons": "^5.7.0",
    "react-router": "^8.5.1",
    "sass": "^1.108.2",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@biomejs/biome": "^2.6.8",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@types/node": "^25.9.9",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "i18next-cli": "^1.93.0",
    "jotai-babel": "^0.1.0",
    "jotai-devtools": "^0.15.1",
    "rollup-plugin-visualizer": "^5.14.0",
    "typescript": "7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^1.3.0"
  }
}
