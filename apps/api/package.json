{
  "name": "syntax-analyzer-api",
  "version": "1.0.0",
  "description": "Personal project server that provides a RESTful API",
  "main": "dist/server.js",
  "_moduleAliases": {
    "@": "dist"
  },
  "scripts": {
    "start:dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node -r module-alias/register dist/server.js",
    "build": "tsc",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm build && node --test",
    "type-check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [],
  "author": "Romantech",
  "license": "ISC",
  "dependencies": {
    "@langchain/core": "^1.3.7",
    "@langchain/openai": "^1.8.3",
    "@types/request-ip": "^0.0.41",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "langchain": "^1.6.4",
    "module-alias": "^2.3.5",
    "openai": "^7.55.0",
    "request-ip": "^3.3.0",
    "syntax-analyzer-shared": "workspace:*",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/module-alias": "^2.0.4",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json}": "pnpm --filter syntax-analyzer-api exec biome check --write"
  }
}
