# Required. Use development locally and production for deployment.
NODE_ENV=development
# Optional locally (defaults to 3001). Required in production (8000 on Koyeb).
PORT=3001
# Optional comma-separated origins, e.g. https://example.com,http://localhost:5173
CORS_ORIGIN=
# Optional. Set a stable signing secret of at least 32 bytes to enable browser quotas.
ANALYZER_COOKIE_SECRET=
# Optional. Comma-separated Cloudflare IPv4/IPv6 CIDRs for a proxied API hostname.
# Leave empty when the API hostname uses Cloudflare DNS only.
ANALYZER_CLOUDFLARE_CIDRS=

# Required.
OPENAI_API_KEY=

# Defaults for local Redis. Use the service values for remote Redis.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# All four model IDs are required. Use your provisioned fine-tuned model IDs.
MODEL_PRIMARY=gpt-5.4
MODEL_FAST=gpt-5-mini
MODEL_PRIMARY_FT=
MODEL_FAST_FT=
